# Virtual environment - the assignment requires this stays out of the repo
.venv/
venv/
env/
ENV/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.so

# The SQLite database is generated by init_db.py and is never committed.
# Delete it and re-run init_db.py after any model change.
instance/
*.db
*.sqlite
*.sqlite3

# Packaging output from `python -m build` (the gpa_calculator distribution)
dist/
build/
*.egg-info/
.eggs/

# PyPI credentials - never commit an API token
.pypirc

# Secrets and local config
.env
.env.*
!.env.example

# Tests and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Editors
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
